# Optional read-only release profile.
#
# Applied last, on top of the Nano product profile, to build an image with the
# AccessPort write service compiled out entirely. Without this symbol the
# write service returns ESP_ERR_NOT_SUPPORTED and no write code path exists at
# runtime.
#
# This is NOT what is published for browser flashing — the published image is
# the Nano product profile, with guarded writes compiled in and runtime owner
# consent defaulting to locked. Writing a .ptm file to the AccessPort's own
# storage does not put a calibration into a vehicle: installing a map remains
# a deliberate action taken on the AccessPort itself.
#
# Keep this profile for anyone who wants the narrower image, and for testing
# that the #else paths still compile.
CONFIG_REVLINK_ALLOW_DEVICE_WRITES=n
