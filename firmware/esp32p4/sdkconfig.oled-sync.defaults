# One-run, read-only OLED workflow demonstration.
#
# This runs the normal bounded runtime sync, renders its state on the accepted
# SH1106 display, performs the acknowledged 0x05/0x35 polite close, and stops
# the logical root port. Device writes, deletes, formatting, and live-data
# commands remain disabled.
CONFIG_REVLINK_STATUS_OLED=y
CONFIG_REVLINK_DEV_CONSOLE=y
CONFIG_REVLINK_USB_ROOT_PORT_POWER=y
CONFIG_REVLINK_RUNTIME_SYNC=y
CONFIG_REVLINK_SYNC_AUTO_ON_ATTACH_DEFAULT=y
CONFIG_REVLINK_USB_PC_MODE_EXIT_ACCEPTANCE=y
# CONFIG_REVLINK_USB_INTERFACE_CLAIM_ACCEPTANCE is not set
# CONFIG_REVLINK_USB_ROOT_LIST_ACCEPTANCE is not set
# CONFIG_REVLINK_USB_DOWNLOAD_ACCEPTANCE is not set
# CONFIG_REVLINK_USB_INCREMENTAL_SYNC_ACCEPTANCE is not set
# CONFIG_REVLINK_USB_SESSION_CLOSE_ACCEPTANCE is not set
# CONFIG_REVLINK_USB_IDLE_RELEASE_ACCEPTANCE is not set
# CONFIG_REVLINK_USB_SESSION_CYCLE_ACCEPTANCE is not set
# CONFIG_REVLINK_USB_CLOSE_RECOVERY_ACCEPTANCE is not set
# CONFIG_REVLINK_ALLOW_DEVICE_WRITES is not set
# CONFIG_REVLINK_SD_FORMAT_ACCEPTANCE is not set
