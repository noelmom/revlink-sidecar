# One-shot AccessPort root-list acceptance overlay.
#
# This configuration performs exactly one bounded read-only directory-list
# request per boot. It intentionally leaves every write, delete, format,
# live-data, and idle-release capability disabled.
CONFIG_REVLINK_USB_ROOT_PORT_POWER=y
# CONFIG_REVLINK_USB_INTERFACE_CLAIM_ACCEPTANCE is not set
CONFIG_REVLINK_USB_ROOT_LIST_ACCEPTANCE=y
# CONFIG_REVLINK_USB_IDLE_RELEASE_ACCEPTANCE is not set
# CONFIG_REVLINK_ALLOW_DEVICE_WRITES is not set
# CONFIG_REVLINK_SD_FORMAT_ACCEPTANCE is not set
