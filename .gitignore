# ESP-IDF / CMake build output
build/
build-*/
sdkconfig
sdkconfig.old
managed_components/
*.elf
*.bin
*.map

# Published release artefacts are tracked on purpose: the web flasher
# serves them same-origin and verifies them against manifest.json.
!web/flash/firmware/**/*.bin

# Host test builds
cmake-build-*/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local secrets — never commit
*.env
.env
.env.*
!*.env.example
secrets.*
wifi-credentials.*

# ESP-IDF managed component cache
managed_components/
dependencies.lock.bak
